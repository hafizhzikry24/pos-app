{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "dual-display": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_NATIVE_DISPLAY": "true",
        "EXPO_PUBLIC_DUAL_SCREEN": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
