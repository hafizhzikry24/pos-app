<?xml version="1.0" encoding="utf-8"?>
<!--
    Customer-facing secondary display layout.
    Modern dark-blue design with:
      - Branded gradient header
      - Idle/welcome section (visible when cart is empty)
      - Active cart section (visible when cart has items)
      - Sticky total footer
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/cd_background_gradient">

    <!-- ═══════════════════════════════════════ HEADER ═══════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- Store Branding Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Logo Icon Circle -->
            <LinearLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/cd_badge_bg"
                android:gravity="center"
                android:layout_marginEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛒"
                    android:textSize="26sp" />

            </LinearLayout>

            <!-- Store Name + Tagline -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POS System"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/cd_text_primary"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Display"
                    android:textSize="13sp"
                    android:textColor="@color/cd_accent"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Date/Time placeholder — updated programmatically -->
            <TextView
                android:id="@+id/header_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/cd_text_secondary"
                android:gravity="end" />

        </LinearLayout>

        <!-- Accent divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/cd_divider"
            android:layout_marginTop="18dp"
            android:alpha="0.6" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════ IDLE / WELCOME STATE ════════════════════════ -->
    <LinearLayout
        android:id="@+id/idle_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <!-- Shopping bag emoji large -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛍️"
            android:textSize="72sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome!"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/cd_text_primary"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thank you for shopping with us."
            android:textSize="18sp"
            android:textColor="@color/cd_text_secondary"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Items will appear here as they are added."
            android:textSize="15sp"
            android:textColor="@color/cd_text_muted"
            android:layout_gravity="center_horizontal"
            android:gravity="center" />

        <!-- Decorative accent dot row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="36dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/cd_badge_bg"
                android:layout_marginEnd="6dp" />
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/cd_badge_bg"
                android:alpha="0.5"
                android:layout_marginEnd="6dp" />
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/cd_badge_bg"
                android:alpha="0.25" />

        </LinearLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════ ACTIVE CART STATE ════════════════════════════ -->
    <LinearLayout
        android:id="@+id/cart_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="4dp">

        <!-- Section label row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your Order"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/cd_text_primary" />

            <!-- Item count badge -->
            <TextView
                android:id="@+id/item_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 items"
                android:textSize="13sp"
                android:textColor="@color/cd_badge_text"
                android:textStyle="bold"
                android:background="@drawable/cd_badge_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- Scrollable cart items list -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/cart_items_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

        </ScrollView>

    </LinearLayout>

    <!-- ═══════════════════════════════════════ TOTAL FOOTER ════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Thin divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cd_divider"
            android:layout_marginBottom="16dp" />

        <!-- Total card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/cd_total_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/cd_total_text" />

            <TextView
                android:id="@+id/total_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/cd_total_text" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
