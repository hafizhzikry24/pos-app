<?xml version="1.0" encoding="utf-8"?>
<!--
    Cart item row for the customer-facing secondary display.
    Uses a card-style design with quantity badge, item name, price, and line total.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/cd_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Quantity Badge -->
        <TextView
            android:id="@+id/item_qty_badge"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cd_badge_text"
            android:background="@drawable/cd_badge_bg"
            android:layout_marginEnd="14dp" />

        <!-- Item Name + Unit Price -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cd_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/item_unit_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0 / item"
                android:textSize="13sp"
                android:textColor="@color/cd_text_secondary"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <!-- Line Total -->
        <TextView
            android:id="@+id/item_line_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cd_accent"
            android:layout_marginStart="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
